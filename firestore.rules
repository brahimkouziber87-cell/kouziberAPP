rules_version = '2';

// ---------------------------------------------------------------------------
// Cloud backup rules.
//
// Threat model: the Firebase web API key is public (it ships with the app), so
// the rules are the only access boundary. Every read/write therefore requires a
// signed-in Firebase user with a VERIFIED email, and a gmail_* slot can only be
// touched by the account that owns that email address.
// ---------------------------------------------------------------------------
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function hasVerifiedEmail() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isGmailSlot(userId) {
      return userId is string && userId.size() >= 10 && userId.size() <= 128
        && userId.matches('^gmail_[a-zA-Z0-9_\\-]+$');
    }

    // The caller owns the document that lives at their own Firebase Auth uid.
    function isUidOwner(userId) {
      return isSignedIn() && userId is string && request.auth.uid == userId;
    }

    // The caller owns an existing gmail_* slot: its stored email must equal the
    // caller's verified token email.
    function ownsGmailSlot(userId) {
      return hasVerifiedEmail() && isGmailSlot(userId)
        && resource.data.userEmail == request.auth.token.email;
    }

    // The caller owns the gmail_* slot they are creating.
    function claimsGmailSlot(userId) {
      return hasVerifiedEmail() && isGmailSlot(userId)
        && request.resource.data.userEmail == request.auth.token.email;
    }

    // Writes must always carry the caller's own verified email as owner marker.
    function claimsOwnEmail() {
      return hasVerifiedEmail() && request.resource.data.userEmail == request.auth.token.email;
    }

    function canReadSlot(userId) {
      return isUidOwner(userId) || ownsGmailSlot(userId);
    }

    function parentSlotData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    // Chunk writes are only allowed under a parent slot the caller owns.
    function canAccessChunks(userId) {
      return isSignedIn() && (
        isUidOwner(userId)
        || (hasVerifiedEmail() && isGmailSlot(userId)
            && parentSlotData(userId).userEmail == request.auth.token.email)
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidUserBackup(data) {
      return data.keys().hasOnly([
          'appData',
          'isCompressed',
          'isChunked',
          'chunksCount',
          'totalRawSize',
          'compressedSize',
          'lastUpdated',
          'lastSavedTimestamp',
          'userEmail'
        ])
        && data.keys().hasAll(['userEmail'])
        && data.userEmail is string && data.userEmail.size() > 0 && data.userEmail.size() <= 256
        && (!('appData' in data) || (data.appData is string && data.appData.size() <= 900000))
        && (!('isCompressed' in data) || data.isCompressed is bool)
        && (!('isChunked' in data) || data.isChunked is bool)
        && (!('chunksCount' in data) || (data.chunksCount is number && data.chunksCount >= 0 && data.chunksCount <= 500))
        && (!('totalRawSize' in data) || (data.totalRawSize is number && data.totalRawSize >= 0))
        && (!('compressedSize' in data) || (data.compressedSize is number && data.compressedSize >= 0))
        && (!('lastUpdated' in data) || (data.lastUpdated is string && data.lastUpdated.size() <= 64))
        && (!('lastSavedTimestamp' in data) || (data.lastSavedTimestamp is number && data.lastSavedTimestamp >= 0));
    }

    function isValidBackupChunk(data) {
      return data.keys().hasAll(['chunk', 'index', 'totalChunks', 'lastUpdated'])
        && data.keys().hasOnly(['chunk', 'index', 'totalChunks', 'lastUpdated'])
        && data.chunk is string && data.chunk.size() <= 900000
        && data.index is number && data.index >= 0 && data.index <= 500
        && data.totalChunks is number && data.totalChunks >= 1 && data.totalChunks <= 500
        && data.lastUpdated is string && data.lastUpdated.size() <= 64;
    }

    match /users/{userId} {
      allow get, list: if canReadSlot(userId);

      allow create: if (isUidOwner(userId) || claimsGmailSlot(userId))
        && claimsOwnEmail()
        && isValidUserBackup(incoming());

      allow update: if (isUidOwner(userId) || ownsGmailSlot(userId))
        && claimsOwnEmail()
        && isValidUserBackup(incoming());

      allow delete: if canReadSlot(userId);

      match /chunks/{chunkId} {
        allow get, list: if canAccessChunks(userId) && isValidId(chunkId);
        allow create, update: if canAccessChunks(userId) && isValidId(chunkId) && isValidBackupChunk(incoming());
        allow delete: if canAccessChunks(userId) && isValidId(chunkId);
      }
    }
  }
}
