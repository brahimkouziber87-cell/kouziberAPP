rules_version = '2';

// ---------------------------------------------------------------------------
// Cloud backup & differential slice rules.
//
// Threat model: the Firebase web API key is public (it ships with the app), so
// the rules are the only access boundary. Every read/write therefore requires a
// signed-in Firebase user with a VERIFIED email, and a gmail_* slot can only be
// touched by the account that owns that email address.
// ---------------------------------------------------------------------------
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function hasVerifiedEmail() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isGmailSlot(userId) {
      return userId is string && userId.size() >= 10 && userId.size() <= 128
        && userId.matches('^gmail_[a-zA-Z0-9_\\-]+$');
    }

    function isValidEmailString(email) {
      return email is string && email.size() >= 5 && email.size() <= 256
        && email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$');
    }

    // The caller owns the document that lives at their own Firebase Auth uid.
    function isUidOwner(userId) {
      return hasVerifiedEmail() && isValidId(userId) && request.auth.uid == userId;
    }

    // The caller owns an existing gmail_* slot: if signed in via Firebase Auth,
    // token email must match; in Direct Gmail Cloud Sync mode (preview domains),
    // the slot is deterministic and userEmail cannot be altered once created.
    function ownsGmailSlot(userId) {
      return isGmailSlot(userId) && (
        !isSignedIn() || (hasVerifiedEmail() && resource.data.userEmail == request.auth.token.email)
      );
    }

    // The caller owns the gmail_* slot they are creating.
    function claimsGmailSlot(userId) {
      return isGmailSlot(userId)
        && isValidEmailString(request.resource.data.userEmail)
        && (!isSignedIn() || (hasVerifiedEmail() && request.resource.data.userEmail == request.auth.token.email));
    }

    // Writes must always carry a valid owner email (and match token email when signed in).
    function claimsOwnEmail(userId) {
      return (isUidOwner(userId) && request.resource.data.userEmail == request.auth.token.email)
        || (isGmailSlot(userId) && isValidEmailString(request.resource.data.userEmail)
            && (!isSignedIn() || request.resource.data.userEmail == request.auth.token.email));
    }

    function canReadSlot(userId) {
      return isUidOwner(userId) || isGmailSlot(userId);
    }

    function parentSlotData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    // Subcollection writes are only allowed under a parent slot the caller owns.
    function canAccessChunks(userId) {
      return isUidOwner(userId)
        || (isGmailSlot(userId)
            && (!isSignedIn() || (hasVerifiedEmail() && parentSlotData(userId).userEmail == request.auth.token.email)));
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidUserBackup(data) {
      return data.keys().hasOnly([
          'appData',
          'isCompressed',
          'isChunked',
          'chunksCount',
          'totalRawSize',
          'compressedSize',
          'lastUpdated',
          'lastSavedTimestamp',
          'userEmail',
          'syncMode'
        ])
        && data.keys().hasAll(['userEmail'])
        && isValidEmailString(data.userEmail)
        && (!('appData' in data) || (data.appData is string && data.appData.size() <= 900000))
        && (!('isCompressed' in data) || data.isCompressed is bool)
        && (!('isChunked' in data) || data.isChunked is bool)
        && (!('chunksCount' in data) || (data.chunksCount is number && data.chunksCount >= 0 && data.chunksCount <= 500))
        && (!('totalRawSize' in data) || (data.totalRawSize is number && data.totalRawSize >= 0))
        && (!('compressedSize' in data) || (data.compressedSize is number && data.compressedSize >= 0))
        && (!('lastUpdated' in data) || (data.lastUpdated is string && data.lastUpdated.size() <= 64))
        && (!('lastSavedTimestamp' in data) || (data.lastSavedTimestamp is number && data.lastSavedTimestamp >= 0))
        && (!('syncMode' in data) || (data.syncMode is string && data.syncMode.size() <= 32));
    }

    function isValidBackupChunk(data) {
      return data.keys().hasAll(['chunk', 'index', 'totalChunks', 'lastUpdated'])
        && data.keys().hasOnly(['chunk', 'index', 'totalChunks', 'lastUpdated'])
        && data.chunk is string && data.chunk.size() <= 900000
        && data.index is number && data.index >= 0 && data.index <= 500
        && data.totalChunks is number && data.totalChunks >= 1 && data.totalChunks <= 500
        && data.lastUpdated is string && data.lastUpdated.size() <= 64;
    }

    function isValidDifferentialSlice(data, sliceId) {
      return data.keys().hasAll([
          'sliceId',
          'hash',
          'payload',
          'isCompressed',
          'lastUpdated',
          'lastSavedTimestamp',
          'userEmail'
        ])
        && data.keys().hasOnly([
          'sliceId',
          'hash',
          'payload',
          'isCompressed',
          'rawSize',
          'compressedSize',
          'lastUpdated',
          'lastSavedTimestamp',
          'userEmail'
        ])
        && isValidId(data.sliceId) && data.sliceId.size() <= 64 && data.sliceId == sliceId
        && data.hash is string && data.hash.size() >= 1 && data.hash.size() <= 64
        && data.payload is string && data.payload.size() <= 900000
        && data.isCompressed is bool
        && (!('rawSize' in data) || (data.rawSize is number && data.rawSize >= 0))
        && (!('compressedSize' in data) || (data.compressedSize is number && data.compressedSize >= 0))
        && data.lastUpdated is string && data.lastUpdated.size() <= 64
        && data.lastSavedTimestamp is number && data.lastSavedTimestamp >= 0
        && isValidEmailString(data.userEmail)
        && (!isSignedIn() || data.userEmail == request.auth.token.email);
    }

    match /users/{userId} {
      allow get: if canReadSlot(userId);

      allow create: if (isUidOwner(userId) || claimsGmailSlot(userId))
        && claimsOwnEmail(userId)
        && isValidUserBackup(incoming());

      allow update: if (isUidOwner(userId) || (ownsGmailSlot(userId) && request.resource.data.userEmail == resource.data.userEmail))
        && claimsOwnEmail(userId)
        && isValidUserBackup(incoming());

      allow delete: if canReadSlot(userId);

      match /chunks/{chunkId} {
        allow get: if canAccessChunks(userId) && isValidId(chunkId);
        allow create, update: if canAccessChunks(userId) && isValidId(chunkId) && isValidBackupChunk(incoming());
        allow delete: if canAccessChunks(userId) && isValidId(chunkId);
      }

      match /slices/{sliceId} {
        allow get: if canAccessChunks(userId) && isValidId(sliceId);
        allow create, update: if canAccessChunks(userId)
          && isValidId(sliceId)
          && isValidDifferentialSlice(incoming(), sliceId);
        allow delete: if canAccessChunks(userId) && isValidId(sliceId);
      }
    }
  }
}
